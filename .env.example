# ─── Database ──────────────────────────────────────────────────────────────────
# For Vercel: use Vercel Postgres, Neon, or Supabase connection string
# Format: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silentpay?schema=public"

# ─── Midnight Network ──────────────────────────────────────────────────────────
# Set your Midnight private key (keep secret, never commit)
MIDNIGHT_PRIVATE_KEY=
MIDNIGHT_NETWORK=preview

# Proof server — optional for web app, required for ZK proof generation (claiming)
# For local dev: run `docker compose up -d` to start proof server on port 6300
# For production: deploy proof server separately and set URL here
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
MIDNIGHT_FAUCET_URL=https://faucet.preview.midnight.network/

# ─── App ───────────────────────────────────────────────────────────────────────
# For Vercel: set to your deployment URL (e.g. https://silentpay.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NETWORK=preview
NEXT_PUBLIC_WALLET_NAME=SilentPay

# ─── Private State ─────────────────────────────────────────────────────────────
# Minimum 16 characters. Generate a secure random string for production.
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1
